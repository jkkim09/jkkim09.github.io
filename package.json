{
  "name": "jk-portfolio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "김자경 개발자 포트폴리오",
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "npm run typecheck && vite build && node scripts/publish-build-to-pages.ts",
    "preview": "vite preview",
    "copy": "node scripts/publish-build-to-pages.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run test && npm run build",
    "login": "firebase login",
    "init": "firebase init",
    "server": "firebase serve --only hosting",
    "deploy": "firebase deploy --only hosting"
  },
  "dependencies": {
    "@fullcalendar/react": "^7.1.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "swiper": "^14.4.0",
    "tailwind-merge": "^3.7.0",
    "temporal-polyfill": "^1.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
